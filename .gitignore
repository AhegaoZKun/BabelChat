.ruff_cache/

# Temp
temp/

# Runtime config/state (user-specific)
config.json
overlay_settings.json
settings_dialog_pos.json

# Logs & lock files
*.log
*.lock
# ...except the scanner's, which pins what CI builds. A cdylib nobody
# publishes wants a reproducible dependency set, not a fresh resolve per run.
!babelchat_scanner_win/Cargo.lock

# Downloaded addons (research)
AutoChatLog/

# Build artifacts
build/
dist/
AppDir/
# Ignore the directory's CONTENTS, not the directory: git cannot re-include
# a file whose parent directory is itself excluded, so `tools/` would make
# the exception below silently do nothing.
tools/*
# The build helpers a checkout needs to reproduce a shipped asset stay in.
# docs/tech/addon.md points at this one, and an ignored generator makes the
# committed icon impossible for anyone else to regenerate.
!tools/make_addon_icon.py

# Rust build artifacts
babelchat_scanner/target/
app/libbabelchat_scanner.so

# Environment
.env

# SQLite
*.db

