config.json
*.bak

# Rust scanner build artifacts
babelchat_scanner_*/target/

# Local dev tools (fork-local)
.frai/
.claude-lib/

# Store API tokens, kept as files so they never pass through a terminal or a
# chat log on the way to `gh secret set`. Ignored before they exist on purpose:
# this repository is public and `git add -A` is a habit.
.cf
.curseforge
.wago
*.token
# GigaChat credentials, handed over the same way: a file, never a paste into a
# terminal or a chat log. The bare name is here because .gc matches none of the
# patterns below, and a credential that is ignored only by luck is not ignored.
.gc
.secrets/
# Anything at the repository root that reads as a credential file.
.*token*
.*secret*
.*api-key*

# Built by the release workflow: the staged addon and the store release notes
# extracted from CHANGELOG.md for the version being published.
/.release
/RELEASE_NOTES.md
