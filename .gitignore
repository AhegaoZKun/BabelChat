BabelChat.AppDir/BabelChat.desktop
BabelChat.AppDir/.DirIcon
BabelChat.AppDir/usr/bin/BabelChat
addon/BabelChat.zip
addon.zip
app.zip
app/babelchat_scanner_win.dll

